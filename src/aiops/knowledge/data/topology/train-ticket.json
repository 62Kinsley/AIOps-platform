{
  "system": "Train Ticket",
  "key": "train-ticket",
  "datasets": [
    "RE1-TT",
    "RE2-TT",
    "RE3-TT"
  ],
  "source": "FudanSELab's Train Ticket. Service-to-service calls are those observed in the pre-alert traces of every RE2-TT and RE3-TT case; database links come from the services' MongoDB client spans and the naming convention ts-X-service -> ts-X-mongo; gateway links are the services whose spans start traces.",
  "services": {
    "ts-ui-dashboard": {
      "kind": "gateway",
      "tech": "nginx",
      "description": "Web UI and API gateway: routes /api/v1/... requests to the services. Not traced, so requests appear as root spans of the services behind it. All user traffic enters here."
    },
    "ts-auth-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Login and JWT tokens; credentials in ts-auth-mongo."
    },
    "ts-user-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "User accounts."
    },
    "ts-verification-code-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Login captcha (verification codes)."
    },
    "ts-contacts-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Passengers' contacts."
    },
    "ts-travel-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Trips of high-speed trains (G and D numbers): trip search and remaining tickets."
    },
    "ts-travel2-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Trips of the other trains (K, T, Z numbers): trip search and remaining tickets."
    },
    "ts-ticketinfo-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Ticket information for a trip; forwards to ts-basic-service."
    },
    "ts-basic-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Aggregates the basic data of a trip: stations, train type, route and price."
    },
    "ts-station-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Stations (name and id lookups); the most frequently called service."
    },
    "ts-train-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Train types (seat counts, speed)."
    },
    "ts-route-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Routes: station sequences and distances."
    },
    "ts-price-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Price rates per route and train type."
    },
    "ts-config-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Global configuration values, e.g. seat allocation ratios."
    },
    "ts-seat-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Seat allocation and remaining-seat counts; reads orders to find sold seats."
    },
    "ts-order-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Orders of high-speed trains."
    },
    "ts-order-other-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Orders of the other trains."
    },
    "ts-preserve-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Books tickets on high-speed trains: checks security, contacts and the trip, takes a seat, creates the order, adds insurance, food and consignment."
    },
    "ts-preserve-other-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Books tickets on the other trains (same flow as ts-preserve-service)."
    },
    "ts-security-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Security checks before booking (limits on recent orders)."
    },
    "ts-assurance-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Travel insurance."
    },
    "ts-food-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Food orders for trips."
    },
    "ts-food-map-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Food stores at stations and food served on trains."
    },
    "ts-consign-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Luggage consignment."
    },
    "ts-consign-price-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Consignment prices."
    },
    "ts-inside-payment-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Payment inside the platform (account balance); calls ts-payment-service and updates the order's status."
    },
    "ts-payment-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Payment processing."
    },
    "ts-cancel-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Order cancellation and refunds."
    },
    "ts-rebook-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Ticket rebooking."
    },
    "ts-execute-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Ticket collection and check-in."
    },
    "ts-notification-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Order notifications (e-mail)."
    },
    "ts-route-plan-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Route planning (cheapest, quickest, fewest stops)."
    },
    "ts-travel-plan-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Travel plans that combine trips and transfers."
    },
    "ts-ticket-office-service": {
      "kind": "service",
      "description": "Ticket office locations."
    },
    "ts-news-service": {
      "kind": "service",
      "description": "News shown in the UI."
    },
    "ts-voucher-service": {
      "kind": "service",
      "description": "Travel vouchers; data in ts-voucher-mysql."
    },
    "ts-avatar-service": {
      "kind": "service",
      "description": "User avatars."
    },
    "ts-admin-basic-info-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Admin pages for stations, trains, configs, prices and contacts."
    },
    "ts-admin-order-service": {
      "kind": "service",
      "tech": "Java (Spring Boot)",
      "description": "Admin pages for orders."
    },
    "ts-admin-route-service": {
